    "# swappable container: single \"Pump launch power\" field for forward/backward,\n",
    "# or separate forward/backward fields for bidirectional pumping\n",
    "pump_power_single_box = widgets.VBox([PpL_w])\n",
    "pump_power_bidir_box  = widgets.VBox([PpF_w, PpB_w])\n",
    "pump_power_container  = widgets.VBox([pump_power_single_box])\n",
    "\n",
    "simulate_box = widgets.VBox([gr_w, gbeff_w, Pr0_w, pump_power_container, PsbsL_w,\n",
