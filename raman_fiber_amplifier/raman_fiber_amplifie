    "\n",
    "\n",
    "def on_mode_change(change):\n",
    "    if change['new'] == 'Simulate amplifier':\n",
    "        mode_container.children = [simulate_box]\n",
    "        direction_w.options = ['Backward pumping', 'Forward pumping', 'Bidirectional pumping']\n",
    "    else:\n",
    "        # gr extraction currently only supports a single pump end being\n",
    "        # measured, so bidirectional pumping isn't offered here\n",
    "        if direction_w.value == 'Bidirectional pumping':\n",
