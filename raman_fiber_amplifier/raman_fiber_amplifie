    "        direction_map = {'Forward pumping': 'forward', 'Backward pumping': 'backward',\n",
    "                          'Bidirectional pumping': 'bidirectional'}\n",
    "        direction = direction_map[direction_w.value]\n",
    "        # dB/km -> dB/m -> 1/m\n",
    "        alfap = (alfap_dB_w.value / 1000) * np.log(10) / 10\n",
    "        alfas = (alfas_dB_w.value / 1000) * np.log(10) / 10\n",
    "        L = L_w.value\n",
    "        Aeff = Aeff_w.value\n",
    "        eps = eps_w.value\n",
    "        lambdP = lambdP_w.value\n",
    "        lambdR = lambdR_w.value\n",
    "        # mW -> W\n",
    "        Pr0 = Pr0_w.value * 1e-3\n",
    "        PsbsL = PsbsL_w.value * 1e-3\n",
    "\n",
    "        if mode_w.value == 'Simulate amplifier':\n",
    "            if direction == 'bidirectional':\n",
    "                lengths, pr, psbs, pump_data = simulate(\n",
    "                    L, dz_w.value, nodes_w.value, gr_w.value, eps, gbeff_w.value, Aeff,\n",
    "                    alfap, alfas, lambdP, lambdR, Pr0, PsbsL, direction,\n",
    "                    PpF=PpF_w.value, PpB=PpB_w.value)\n",
    "            else:\n",
    "                lengths, pr, psbs, pump_data = simulate(\n",
    "                    L, dz_w.value, nodes_w.value, gr_w.value, eps, gbeff_w.value, Aeff,\n",
    "                    alfap, alfas, lambdP, lambdR, Pr0, PsbsL, direction,\n",
    "                    PpL=PpL_w.value)\n",
    "\n",
    "            plt.figure(figsize=(7, 5))\n",
    "            plt.plot(lengths, pr, label='Signal power at z = L [W]')\n",
    "            plt.plot(lengths, psbs, label='SBS power at z = 0 [W]')\n",
    "            if show_pump_w.value:\n",
    "                if direction == 'bidirectional':\n",
    "                    plt.plot(lengths, pump_data['pump_fwd'],\n",
    "                             label='Forward pump power at z = L [W]')\n",
    "                    plt.plot(lengths, pump_data['pump_bwd'],\n",
    "                             label='Backward pump power at z = 0 [W]')\n",
    "                else:\n",
    "                    pump_end = 'z = L' if direction == 'forward' else 'z = 0'\n",
    "                    plt.plot(lengths, pump_data['pump'], label=f'Pump power at {pump_end} [W]')\n",
    "            plt.legend()\n",
    "            plt.xlabel('Amplifier length [m]')\n",
    "            plt.ylabel('Optical power [W]')\n",
    "            plt.xlim(0, L)\n",
    "            plt.title(f'{direction_w.value}')\n",
    "            plt.show()\n",
    "        else:\n",
    "            Ps_in = Ps_in_w.value * 1e-3\n",
    "            Ps_out = Ps_out_w.value * 1e-3\n",
    "            gr_an = extract_gr_analytic(L, Ps_in, Ps_out, Pp_launch_w.value,\n",
    "                                         eps, Aeff, alfap, alfas)\n",
    "            gr_num = extract_gr_numeric(L, Ps_in, Ps_out, Pp_launch_w.value,\n",
    "                                         eps, Aeff, alfap, alfas, lambdP, lambdR, direction)\n",
    "            print(f\"Analytic (undepleted-pump) estimate : gr = {gr_an:.4e} m/W\")\n",
    "            if gr_num is not None:\n",
    "                print(f\"Numeric (full BVP fit) result       : gr = {gr_num:.4e} m/W\")\n",
    "            else:\n",
    "                print(\"Numeric fit did not converge in the default bracket \"\n",
    "                      \"(1e-16 - 1e-11 m/W). Check the input powers/length, \"\n",
    "                      \"or widen gr_bounds in extract_gr_numeric().\")\n",
    "\n",
    "\n",
    "run_btn.on_click(on_run_clicked)\n",
    "\n",
    "ui = widgets.VBox([mode_w, direction_w, shared_box, mode_container, run_btn, out])\n",
    "display(ui)\n",
    "\n"
   ]
